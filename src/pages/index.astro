---
import { getCollection } from "astro:content";
import JobCard from "../components/content/JobCard.astro";
import PostCard from "../components/content/PostCard.astro";
import ProjectCard from "../components/content/ProjectCard.astro";
import Section from "../components/content/Section.astro";
import ArrowLink from "../components/ui/ArrowLink.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import { yearsSince } from "../lib/dates";
import { sortJobs } from "../lib/jobs";
import { selectLatest } from "../lib/posts";
import { selectFeatured } from "../lib/projects";
import { RESUME_HREF, SITE } from "../site";

const jobs = sortJobs(await getCollection("jobs"));
const projects = selectFeatured(await getCollection("projects"));
const posts = selectLatest(await getCollection("blog"), 3);
const years = yearsSince(SITE.careerStart, new Date());
---

<HomeLayout title={SITE.name} description={SITE.description}>
  <Section id="about" title="About">
    <div class="about-prose">
      <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
    </div>
  </Section>



  <Section id="projects" title="Projects">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          slug={project.id}
          description={project.data.description}
          href={project.data.url}
          repo={project.data.repo}
          tech={project.data.tech}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          status={project.data.status}
        />
      ))
    }
    <p class="projects-more">
      <ArrowLink href="/projects" direction="e">
        View All projects
      </ArrowLink>
    </p>
  </Section>

  <Section id="experience" title="Experience">
    {
      jobs.map((job) => (
        <JobCard
          company={job.data.company}
          titles={job.data.titles}
          url={job.data.url}
          summary={job.data.summary}
          highlights={job.data.highlights}
          tech={job.data.tech}
          logo={job.data.logo}
          logoAlt={job.data.logoAlt}
        />
      ))
    }
    <p class="experience-more">
      <ArrowLink href={RESUME_HREF} direction="ne" external>
        View my resume
      </ArrowLink>
    </p>
  </Section>

  <Section id="writing" title="Writing">
    {
      posts.length > 0 ? (
        <>
          {posts.map((post) => (
            <PostCard
              title={post.data.title}
              href={`/blog/${post.id}`}
              pubDate={post.data.pubDate}
              description={post.data.description}
              tags={post.data.tags}
            />
          ))}
          <p class="writing-more">
            <ArrowLink href="/blog" direction="e">
              All posts
            </ArrowLink>
          </p>
        </>
      ) : (
        <p class="writing-empty">Nothing published yet — drafts in progress.</p>
      )
    }
  </Section>
</HomeLayout>

<style>
  .about-prose {
    max-inline-size: var(--measure);
  }

  .about-prose p + p {
    margin-block-start: var(--spacing-4);
  }

  .about-prose strong {
    color: var(--fg);
    font-weight: 600;
  }

  .about-prose a {
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-thickness: from-font;
    text-underline-offset: 0.2em;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
  }

  .about-prose a:hover {
    text-decoration-color: currentColor;
  }

  .experience-more,
  .projects-more,
  .writing-more {
    margin-block-start: var(--spacing-8);
  }

  .writing-empty {
    color: var(--fg-dim);
  }
</style>
