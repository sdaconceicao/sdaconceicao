---
import { getCollection } from "astro:content";
import JobCard from "../components/content/JobCard.astro";
import PostCard from "../components/content/PostCard.astro";
import ProjectCard from "../components/content/ProjectCard.astro";
import Section from "../components/content/Section.astro";
import ArrowLink from "../components/ui/ArrowLink.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import { readingTimeMinutes } from "../lib/dates";
import { resolveEntryImage } from "../lib/images";
import { selectHighlights, sortJobs } from "../lib/jobs";
import { selectLatest } from "../lib/posts";
import { selectFeatured } from "../lib/projects";
import { RESUME_HREF, SITE } from "../site";

const jobs = sortJobs(await getCollection("jobs"));
const featuredProjects = selectFeatured(await getCollection("projects")).slice(0, 3);
const [leadProject, ...secondaryProjects] = featuredProjects;
const latestPosts = selectLatest(await getCollection("blog"), 3);
---

<HomeLayout title={SITE.name} description={SITE.description}>
  <Section id="activity" title="Writing" number="01">
    <ArrowLink slot="action" href="/blog" direction="ne">All posts</ArrowLink>

    <div class="post-grid">
      {
        latestPosts.length > 0 ? latestPosts.map((post) => (
          <PostCard
            title={post.data.title}
            href={`/blog/${post.id}`}
            pubDate={post.data.pubDate}
            description={post.data.description}
            readingTime={readingTimeMinutes(post.body ?? "")}
            image={resolveEntryImage(post.filePath, post.data.heroImage)}
            imageAlt={post.data.heroImageAlt}
            showThumbnail={post.data.showThumbnail}
            variant="signal"
          />
        )) : (
          <p class="activity-empty">Nothing published yet — drafts in progress.</p>
        )
      }
    </div>
  </Section>

  <Section id="projects" title="Selected projects" number="02">
    <ArrowLink slot="action" href="/projects" direction="ne">View all projects</ArrowLink>

    {
      leadProject && (
        <ProjectCard
          title={leadProject.data.title}
          slug={leadProject.id}
          description={leadProject.data.description}
          href={leadProject.data.url}
          repo={leadProject.data.repo}
          tech={leadProject.data.tech}
          image={leadProject.data.image}
          imageAlt={leadProject.data.imageAlt}
          status={leadProject.data.status}
          variant="lead"
        />
      )
    }

    {
      secondaryProjects.length > 0 && (
        <div class="project-secondary">
          {secondaryProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              slug={project.id}
              description={project.data.description}
              href={project.data.url}
              repo={project.data.repo}
              tech={project.data.tech}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              status={project.data.status}
              variant="tile"
            />
          ))}
        </div>
      )
    }
  </Section>

  <Section id="experience" title="Recent experience" number="03">
    <ArrowLink slot="action" href={RESUME_HREF} direction="ne" external>
      Full history in resume
    </ArrowLink>

    <div class="experience-list">
      {
        jobs.map((job) => (
          <JobCard
            company={job.data.company}
            titles={job.data.titles}
            url={job.data.url}
            summary={job.data.summary}
            highlights={selectHighlights(job.data.highlights)}
            tech={job.data.tech}
            logo={job.data.logo}
            logoAlt={job.data.logoAlt}
          />
        ))
      }
    </div>
  </Section>
</HomeLayout>

<style>
  .project-secondary {
    display: grid;
    gap: var(--spacing-4);
    margin-block-start: var(--spacing-4);
  }

  .post-grid {
    display: grid;
    align-items: start;
    gap: var(--spacing-4);
    min-inline-size: 0;
  }

  .activity-empty {
    color: var(--fg-dim);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .project-secondary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
