---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectLinks from "../../components/content/ProjectLinks.astro";
import Prose from "../../components/content/Prose.astro";
import Icon from "../../components/ui/Icon.astro";
import TechTagList from "../../components/ui/TechTagList.astro";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, url, repo, tech, image, imageAlt, images } = project.data;
const galleryImages = image ? [{ src: image, alt: imageAlt }, ...images] : images;
/* A status other than "live" is conveyed as TEXT, not a color. */
const statusLabel = status === "wip" ? "In progress" : status === "archived" ? "Archived" : "Live";
---

<PageLayout
  title={title}
  description={description}
  type="article"
  backHref="/projects"
  backLabel="All projects"
>
  <article class:list={["project-detail", { "project-detail--with-image": image }]}>
    <header class="project-header">
      <h1 class="page-title">{title}</h1>
      <p class="project-meta meta">{statusLabel}</p>
      <ProjectLinks title={title} href={url} repo={repo} />
      <TechTagList items={tech} label={`Technologies used in ${title}`} />
    </header>

    {
      image && (
        <div class="project-gallery-widget" data-project-gallery>
          <Image
            src={image}
            alt={imageAlt}
            class="project-hero"
            widths={[480, 960, 1200, 1600]}
            sizes="(min-width: 90rem) 60vw, (min-width: 64rem) 37rem, 100vw"
            loading="eager"
            data-gallery-image
          />
          {
            galleryImages.length > 1 && (
              <>
                <div class="project-gallery-controls" data-gallery-controls hidden>
                  <button type="button" data-gallery-previous>
                    <Icon name="arrow-w" />
                    <span class="sr-only">Previous image</span>
                  </button>
                  <button type="button" data-gallery-next>
                    <Icon name="arrow-e" />
                    <span class="sr-only">Next image</span>
                  </button>
                </div>
                <div
                  class="project-gallery-thumbnails"
                  role="group"
                  aria-label={`Choose an image of ${title}`}
                  data-gallery-thumbnails
                  hidden
                >
                  {galleryImages.map(({ src, alt }, index) => (
                    <button
                      type="button"
                      aria-pressed={index === 0 ? "true" : "false"}
                      data-gallery-thumbnail
                      data-gallery-alt={alt}
                    >
                      <Image
                        src={src}
                        alt=""
                        class="project-gallery-thumbnail-image"
                        widths={[480, 960, 1200, 1600]}
                        sizes="8rem"
                        loading="lazy"
                      />
                      <span class="sr-only">{`Show image ${index + 1}: ${alt}`}</span>
                    </button>
                  ))}
                </div>
              </>
            )
          }
        </div>
      )
    }

    <Prose>
      <Content />
    </Prose>
  </article>

  {
    images.length > 0 && (
      <section
        class="project-gallery"
        aria-label={`More images of ${title}`}
        data-gallery-fallback
      >
        {images.map(({ src, alt }) => (
          <Image
            src={src}
            alt={alt}
            class="project-gallery-image"
            widths={[480, 960, 1200, 1600]}
            sizes="(min-width: 48rem) 50vw, 100vw"
            loading="lazy"
          />
        ))}
      </section>
    )
  }
</PageLayout>

<script>
  const initProjectGalleries = () => {
    document.querySelectorAll<HTMLElement>("[data-project-gallery]").forEach((gallery) => {
      if (gallery.dataset.galleryBound === "true") return;

      const image = gallery.querySelector<HTMLImageElement>("[data-gallery-image]");
      const controls = gallery.querySelector<HTMLElement>("[data-gallery-controls]");
      const thumbnailList = gallery.querySelector<HTMLElement>("[data-gallery-thumbnails]");
      const thumbnails = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumbnail]")];
      const previous = gallery.querySelector<HTMLButtonElement>("[data-gallery-previous]");
      const next = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
      if (!image || !controls || !thumbnailList || !previous || !next || thumbnails.length < 2) {
        return;
      }

      let active = 0;
      const select = (index: number) => {
        active = (index + thumbnails.length) % thumbnails.length;
        const thumbnail = thumbnails[active];
        const source = thumbnail?.querySelector<HTMLImageElement>("img");
        if (!thumbnail || !source) return;

        for (const attribute of ["src", "srcset", "width", "height"]) {
          const value = source.getAttribute(attribute);
          if (value) image.setAttribute(attribute, value);
        }
        image.alt = thumbnail.dataset.galleryAlt ?? "";
        thumbnails.forEach((button, buttonIndex) => {
          button.setAttribute("aria-pressed", String(buttonIndex === active));
        });
      };

      thumbnails.forEach((button, index) => {
        button.addEventListener("click", () => select(index));
      });
      previous.addEventListener("click", () => select(active - 1));
      next.addEventListener("click", () => select(active + 1));
      controls.hidden = false;
      thumbnailList.hidden = false;
      document.querySelector("[data-gallery-fallback]")?.remove();
      gallery.dataset.galleryBound = "true";
    });
  };

  initProjectGalleries();
  document.addEventListener("astro:page-load", initProjectGalleries);
</script>

<style>
  .project-header {
    margin-block-end: var(--spacing-12);
  }

  .project-meta {
    margin-block-start: var(--spacing-3);
  }

  .project-detail--with-image .project-header {
    margin-block-end: 0;
  }

  .project-gallery-widget {
    display: grid;
    margin-block: var(--spacing-6) var(--spacing-12);
  }

  .project-hero,
  .project-gallery-controls {
    grid-area: 1 / 1;
  }

  /* Matches the blog hero: same border, same large radius, so a project page and
     a post page read as the same template. */
  .project-hero {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    block-size: auto;
    max-inline-size: 100%;
    margin: 0;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .project-gallery-controls {
    align-self: center;
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-3);
    margin-block-start: 0;
    padding-inline: var(--spacing-3);
  }

  .project-gallery-controls button {
    display: grid;
    place-items: center;
    min-block-size: 44px;
    padding: var(--spacing-2) var(--spacing-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background-color: var(--article-hero-overlay);
    color: var(--article-hero-fg);
  }

  .project-gallery-thumbnails {
    display: grid;
    grid-row: 2;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
  }

  .project-gallery-thumbnails button {
    min-block-size: 44px;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .project-gallery-thumbnail-image {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .project-gallery-thumbnails button[aria-pressed="true"] .project-gallery-thumbnail-image {
    border: 3px double var(--accent);
  }

  :global([dir="rtl"]) .project-gallery-controls :global(.icon) {
    scale: -1 1;
  }

  .project-gallery {
    display: grid;
    gap: var(--spacing-6);
    margin-block-start: var(--spacing-12);
  }

  .project-gallery-image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 48rem) {
    .project-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 90rem) {
    .project-detail--with-image {
      display: grid;
      grid-template-areas:
        "header gallery"
        "content gallery";
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--spacing-12) var(--spacing-16);
      align-items: start;
    }

    .project-detail--with-image .project-header {
      grid-area: header;
    }

    .project-detail--with-image .project-gallery-widget {
      grid-area: gallery;
      margin-block: 0;
    }

    .project-detail--with-image > :global(.prose) {
      grid-area: content;
    }
  }
</style>
