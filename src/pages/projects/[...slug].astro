---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ProjectLinks from "../../components/content/ProjectLinks.astro";
import Prose from "../../components/content/Prose.astro";
import TechTagList from "../../components/ui/TechTagList.astro";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, url, repo, tech } = project.data;
/* A status other than "live" is conveyed as TEXT, not a colour. */
const statusLabel = status === "wip" ? "In progress" : status === "archived" ? "Archived" : "Live";
---

<PageLayout
  title={title}
  description={description}
  type="article"
  backHref="/projects"
  backLabel="All projects"
>
  <article>
    <header class="project-header">
      <h1 class="page-title">{title}</h1>
      <p class="project-meta meta">{statusLabel}</p>
      <ProjectLinks title={title} href={url} repo={repo} />
      <TechTagList items={tech} label={`Technologies used in ${title}`} />
    </header>

    <Prose>
      <Content />
    </Prose>
  </article>
</PageLayout>

<style>
  .project-header {
    margin-block-end: var(--spacing-12);
  }

  .project-meta {
    margin-block-start: var(--spacing-3);
  }
</style>
