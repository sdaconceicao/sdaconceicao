---
import { getCollection } from "astro:content";
import PostBrowser from "../../components/content/PostBrowser/PostBrowser.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { selectPublished } from "../../lib/posts";

const posts = selectPublished(await getCollection("blog"));
---

<PageLayout
  title="Writing"
  description="Posts on frontend development, accessibility, and internationalization."
>
  <h1 class="page-title">Writing</h1>

  {posts.length > 0 ? <PostBrowser posts={posts} /> : <p class="empty">No published posts yet.</p>}
</PageLayout>

<style>

  .empty {
    margin-block-start: var(--spacing-8);
    color: var(--fg-dim);
  }
</style>
