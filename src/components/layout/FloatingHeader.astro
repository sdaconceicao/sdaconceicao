---
import { Image } from "astro:assets";
import me from "../../assets/me.png";
import { SOCIALS } from "../../site";
import Icon, { type IconName } from "../ui/Icon.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";

interface Props {
  items: readonly { id: string; label: string; href?: string }[];
  label?: string;
  homeHref?: string;
  variant?: "floating" | "page";
}

const { items, label = "Page sections", homeHref, variant = "floating" } = Astro.props;
const pathname = Astro.url.pathname;
const icons: Record<string, IconName> = {
  projects: "folder",
  experience: "briefcase",
  activity: "file-text",
};
---

<header
  class="floating-header"
  data-variant={variant}
  data-floating-header={variant === "floating" ? "" : undefined}
  hidden={variant === "floating"}
>
  {
    variant === "page" ? (
      <a class="floating-home" href={homeHref ?? "/"}>
        <Icon name="home" size={20} />
        <span class="floating-tooltip" aria-hidden="true">Home</span>
        <span class="sr-only">Home</span>
      </a>
    ) : homeHref ? (
      <a class="floating-home" href={homeHref}>
        <Image src={me} alt="" width={48} height={48} class="floating-avatar" />
        <span class="sr-only">Home</span>
      </a>
    ) : (
      <Image src={me} alt="" width={48} height={48} class="floating-avatar" />
    )
  }
  <nav class="primary-nav" aria-label={label}>
    <ul role="list">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href ?? `#${item.id}`}
              aria-current={
                variant === "page" && item.href
                  ? pathname === item.href
                    ? "page"
                    : pathname.startsWith(`${item.href}/`)
                      ? "location"
                      : undefined
                  : undefined
              }
            >
              <Icon name={icons[item.id] ?? "link"} size={20} />
              <span class="floating-label" aria-hidden="true">{item.label}</span>
              {variant === "page" && <span class="floating-tooltip" aria-hidden="true">{item.label}</span>}
              <span class="sr-only">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    variant === "page" && (
      <>
        <span class="nav-separator" aria-hidden="true" />
        <nav class="social-nav" aria-label="Social links">
          <ul role="list">
            {SOCIALS.map((item) => (
              <li>
                <a
                  href={item.href}
                  rel={/^https?:/i.test(item.href) ? "me noopener noreferrer" : "noopener noreferrer"}
                  target="_blank"
                >
                  <Icon name={item.icon as IconName} size={20} />
                  <span class="floating-tooltip" aria-hidden="true">{item.label}</span>
                  <span class="sr-only">{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="floating-theme">
          <ThemeToggle variant="icon" />
          <span class="floating-tooltip" aria-hidden="true">Theme</span>
        </div>
      </>
    )
  }
</header>

<script>
  const initFloatingHeader = () => {
    const header = document.querySelector<HTMLElement>("[data-floating-header]");
    const hero = document.querySelector<HTMLElement>(".rail");
    const socials = document.querySelector<HTMLElement>("[data-floating-socials]");
    if (!header || !hero || header.dataset.bound === "true") return;

    header.dataset.bound = "true";
    new IntersectionObserver(([entry]) => {
      if (!entry) return;
      const hidden = entry.boundingClientRect.bottom > 0;
      header.hidden = hidden;
      if (socials) socials.hidden = hidden;
    }).observe(hero);
  };

  initFloatingHeader();
  document.addEventListener("astro:page-load", initFloatingHeader);
</script>

<style>
  .floating-header {
    position: fixed;
    z-index: 10;
    inset-block-start: 0;
    inset-inline: 0;
    display: flex;
    align-items: center;
    padding: var(--spacing-1);
    border-block-end: 1px solid var(--border-strong);
    background-color: var(--surface-1);
  }

  .floating-header[hidden] {
    display: none;
  }

  .floating-avatar {
    flex: 0 0 auto;
    inline-size: var(--spacing-10);
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
    object-fit: cover;
  }

  .floating-header[data-variant="page"] {
    position: sticky;
    gap: var(--spacing-4);
    padding-inline: var(--gutter);
  }

  .floating-header[data-variant="page"] .floating-home {
    display: flex;
    gap: var(--spacing-2);
    white-space: nowrap;
  }

  .floating-theme {
    position: relative;
    margin-inline-start: auto;
  }

  .primary-nav {
    flex: 1;
  }

  .primary-nav ul,
  .social-nav ul {
    padding-inline-start: 0;
    list-style: none;
  }

  .primary-nav ul {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
  }

  .floating-home,
  .primary-nav a,
  .social-nav a {
    position: relative;
    display: grid;
    min-inline-size: 44px;
    min-block-size: 44px;
    place-items: center;
    color: var(--fg);
    text-decoration: none;
  }

  .floating-home:hover,
  .floating-home:focus-visible,
  .primary-nav a:hover,
  .primary-nav a:focus-visible,
  .primary-nav a[aria-current],
  .social-nav a:hover,
  .social-nav a:focus-visible {
    color: var(--accent);
  }

  .primary-nav a[aria-current]::before {
    position: absolute;
    inset-block-end: 0;
    inline-size: var(--spacing-5);
    block-size: var(--spacing-1);
    background-color: var(--accent);
    content: "";
  }

  .floating-label,
  .floating-tooltip,
  .nav-separator,
  .social-nav {
    display: none;
  }

  .floating-header[data-variant="page"] .primary-nav {
    position: fixed;
    z-index: 10;
    inset-block-end: 0;
    inset-inline: 0;
    padding-block-end: env(safe-area-inset-bottom);
    border-block-start: 1px solid var(--border-strong);
    background-color: var(--surface-1);
  }

  .floating-header[data-variant="page"] .primary-nav a {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-1);
    padding-block: var(--spacing-2);
  }

  .floating-header[data-variant="page"] .floating-label {
    display: inline;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (min-width: 30rem) {
    .floating-home,
    .primary-nav a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--spacing-2);
    }

    .floating-label {
      display: inline;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
    }
  }

  @media (min-width: 26.25rem) {
    .floating-header[data-variant="page"] {
      position: sticky;
      inset-block-start: 0;
      inset-inline: auto;
      flex-direction: column;
      gap: var(--spacing-2);
      inline-size: var(--spacing-16);
      block-size: 100vh;
      block-size: 100svh;
      padding: var(--spacing-2);
      border-block-end: 0;
      border-inline-end: 1px solid var(--border-strong);
    }

    .floating-header[data-variant="page"] .primary-nav {
      position: static;
      flex: 0 0 auto;
      inline-size: 100%;
      padding-block-end: 0;
      border-block-start: 0;
      background-color: transparent;
    }

    .floating-header[data-variant="page"] .floating-home,
    .floating-header[data-variant="page"] .primary-nav a,
    .floating-header[data-variant="page"] .social-nav a {
      display: grid;
      inline-size: 100%;
      padding: 0;
      place-items: center;
    }

    .floating-header[data-variant="page"] .primary-nav ul,
    .floating-header[data-variant="page"] .social-nav ul {
      display: flex;
      flex-direction: column;
    }

    .floating-header[data-variant="page"] .floating-label {
      display: none;
    }

    .floating-header[data-variant="page"] .primary-nav a[aria-current]::before {
      inset-block: var(--spacing-2);
      inset-inline-start: calc(var(--spacing-2) * -1);
      inline-size: var(--spacing-1);
      block-size: auto;
    }

    .nav-separator {
      display: block;
      inline-size: var(--spacing-6);
      block-size: 1px;
      background-color: var(--border-strong);
    }

    .social-nav {
      display: block;
      inline-size: 100%;
    }

    .floating-theme {
      margin-block-start: auto;
      margin-inline-start: 0;
    }

    .floating-tooltip {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: calc(100% + var(--spacing-3));
      display: block;
      padding: var(--spacing-1) var(--spacing-2);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      background-color: var(--surface-1);
      color: var(--fg);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      line-height: var(--leading-snug);
      opacity: 0;
      pointer-events: none;
      translate: 0 -50%;
      transition:
        opacity var(--dur-fast) var(--ease),
        visibility var(--dur-fast) var(--ease);
      visibility: hidden;
      white-space: nowrap;
    }

    .floating-header[data-variant="page"] a:hover .floating-tooltip,
    .floating-header[data-variant="page"] a:focus-visible .floating-tooltip,
    .floating-header[data-variant="page"] .floating-theme:hover .floating-tooltip,
    .floating-header[data-variant="page"] .floating-theme:focus-within .floating-tooltip {
      opacity: 1;
      visibility: visible;
    }

    :global([dir="rtl"]) .floating-header[data-variant="page"] .floating-tooltip {
      inset-inline-start: auto;
      inset-inline-end: calc(100% + var(--spacing-3));
    }
  }

  @media (min-width: 64rem) and (min-height: 48rem) {
    .floating-header[data-variant="floating"] {
      display: none;
    }
  }
</style>
