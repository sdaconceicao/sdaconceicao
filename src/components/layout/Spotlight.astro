---
/** Cursor-following glow. ~12 lines of JS, guarded, purely decorative. */
---

<div class="spotlight" aria-hidden="true"></div>

<script>
  const el = document.querySelector<HTMLElement>(".spotlight");
  const allowed =
    matchMedia("(pointer: fine)").matches &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches;

  if (el && allowed) {
    let frame = 0;
    addEventListener(
      "pointermove",
      (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          // Written to the ELEMENT, never :root. Writing to :root would
          // invalidate style for every inheriting node, 60 times a second.
          el.style.setProperty("--spot-x", `${event.clientX}px`);
          el.style.setProperty("--spot-y", `${event.clientY}px`);
        });
      },
      { passive: true },
    );
  }
</script>

<style>
  /*
   * A translated, pre-painted fixed layer -- not an animated background-position.
   * Recomputing a radial-gradient's centre repaints the whole viewport every
   * frame; translating a painted layer is compositor-only.
   */
  .spotlight {
    position: fixed;
    z-index: -1;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: var(--spot-size);
    block-size: var(--spot-size);
    margin: calc(var(--spot-size) / -2);
    pointer-events: none;
    background: radial-gradient(circle closest-side, var(--spot-tint), transparent);
    translate: var(--spot-x, 50vw) var(--spot-y, 30vh);
    will-change: translate;
  }

  /*
   * Removed entirely rather than frozen: a stationary red glow with no
   * explanation reads as a rendering artefact, whereas absence reads as design.
   * Also gone under prefers-contrast, because by definition it lowers contrast.
   */
  @media (prefers-reduced-motion: reduce), (prefers-contrast: more), (forced-colors: active) {
    .spotlight {
      display: none;
    }
  }
</style>
