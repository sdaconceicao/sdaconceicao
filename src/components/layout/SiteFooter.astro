---
import { SITE } from "../../site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p>
    Designed and built by {SITE.author}. &copy; {year} {SITE.name}.
  </p>
  <p class="footer-meta">
    Built with <a href="https://astro.build" rel="noopener noreferrer" target="_blank">Astro</a>.
  </p>
</footer>

<style>
  .site-footer {
    padding-block: var(--spacing-12) var(--spacing-16);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
  }

  .footer-meta a {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  .footer-meta a:hover {
    text-decoration-color: currentColor;
  }
</style>
