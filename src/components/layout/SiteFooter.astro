---
import { SITE, SOCIALS } from "../../site";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();
const isHome = Astro.url.pathname === "/";
---

<footer class="site-footer">
  {
    isHome && (
      <nav class="footer-socials" aria-label="Social links" data-floating-socials hidden>
        <SocialLinks items={SOCIALS} />
      </nav>
    )
  }
  <p>
    Designed and built by {SITE.author}. &copy; {year} {SITE.name}.
  </p>
  <p class="footer-meta">
    Built with <a href="https://astro.build" rel="noopener noreferrer" target="_blank">Astro</a>.
  </p>
</footer>

<style>
  .site-footer {
    padding-block: var(--spacing-12) calc(var(--spacing-16) + env(safe-area-inset-bottom));
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: var(--leading-body);
  }

  .footer-meta a {
    color: var(--accent);
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-line: underline;
    text-underline-offset: 0.2em;
  }

  .footer-meta a:hover {
    text-decoration-color: currentColor;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    position: fixed;
    z-index: 10;
    inset-block-end: 0;
    inset-inline: 0;
    padding-block: var(--spacing-1) calc(var(--spacing-1) + env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--border-strong);
    background-color: var(--surface-1);
  }

  .footer-socials[hidden] {
    display: none;
  }

  @media (min-width: 48rem) {
    .footer-socials {
      display: none;
    }
  }
</style>
