---
import TechTag from "./TechTag.astro";

interface Props {
  items: readonly string[];
  label?: string;
}
const { items, label = "Technologies" } = Astro.props;
---

{
  items.length > 0 && (
    /* role="list" is restored explicitly: list-style: none strips list
       semantics in Safari/VoiceOver. */
    <ul class="tags" role="list" aria-label={label}>
      {items.map((item) => (
        <TechTag as="li" label={item} />
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
    margin-block-start: var(--spacing-3);
  }
</style>
