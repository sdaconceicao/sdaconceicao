---
interface Props {
  label: string;
  as?: "li" | "span";
}
const { label, as: Tag = "span" } = Astro.props;
---

<Tag class="tech-tag pill">{label}</Tag>

<style>
  /* The fill needs more inline padding than the outlined pills do, and
     line-height 1.6 is what keeps the fill from cropping descenders. */
  .tech-tag {
    padding: var(--spacing-1) var(--spacing-3);
    background-color: var(--surface-tint);
    color: var(--accent);
    line-height: 1.6;
  }
</style>
