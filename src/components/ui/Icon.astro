---
/**
 * Hand-rolled icon set. Six paths beat an iconify dependency at this scale, and
 * it matches the repo's original "inline svgs for hover events" approach.
 *
 * Decorative by default. focusable="false" matters: legacy Edge/IE put SVGs in
 * the tab order without it, and it costs nothing.
 */
export type IconName =
  | "github"
  | "linkedin"
  | "npm"
  | "arrow-ne"
  | "arrow-e"
  | "arrow-w"
  | "link"
  | "file-text";

interface Props {
  name: IconName;
  size?: number;
  /** Set false and pass a title only when the icon is the sole label. */
  decorative?: boolean;
  title?: string;
  class?: string;
}

const { name, size = 20, decorative = true, title, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
  github:
    "M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.17 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.87.12 3.17.77.84 1.24 1.91 1.24 3.22 0 4.63-2.81 5.65-5.49 5.95.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.83.58A11.99 11.99 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z",
  linkedin:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05a3.75 3.75 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z",
  npm:
    "M1.763 0h20.474C23.172 0 24 .797 24 1.783v20.434C24 23.203 23.172 24 22.237 24H1.763C.828 24 0 23.203 0 22.217V1.783C0 .797.828 0 1.763 0Zm3.767 5.53v12.94h4.03V9.56h3.73v8.91h4.03V5.53H5.53Z",
  "arrow-ne": "M7 17 17 7M9 7h8v8",
  "arrow-e": "M5 12h14M13 6l6 6-6 6",
  "arrow-w": "M19 12H5M11 18l-6-6 6-6",
  link: "M10 13a5 5 0 0 0 7.07 0l3-3A5 5 0 0 0 13 3l-1.5 1.5M14 11a5 5 0 0 0-7.07 0l-3 3A5 5 0 0 0 11 21l1.5-1.5",
  "file-text":
    "M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7l-5-5ZM15 2v5h5M8 13h8M8 17h5",
};

const STROKED: IconName[] = ["arrow-ne", "arrow-e", "arrow-w", "link", "file-text"];
const isStroked = STROKED.includes(name);
const a11y = decorative
  ? { "aria-hidden": "true" as const }
  : { role: "img" as const, "aria-label": title };
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isStroked ? "none" : "currentColor"}
  stroke={isStroked ? "currentColor" : "none"}
  stroke-width={isStroked ? 2 : undefined}
  stroke-linecap={isStroked ? "round" : undefined}
  stroke-linejoin={isStroked ? "round" : undefined}
  focusable="false"
  {...a11y}
>
  {!decorative && title && <title>{title}</title>}
  <path d={PATHS[name]} />
</svg>

<style>
  .icon {
    flex-shrink: 0;
  }
</style>
