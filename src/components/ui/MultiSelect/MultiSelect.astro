---
import Icon from "../Icon.astro";
import styles from "./MultiSelect.module.css";

interface Option {
  label: string;
  value: string;
}

interface Props {
  id: string;
  name: string;
  label: string;
  options: readonly (string | Option)[];
  placeholder: string;
  description: string;
  filter?: boolean;
}

const { id, name, label, options, placeholder, description, filter = false } = Astro.props;
const normalizedOptions = options.map((option) =>
  typeof option === "string" ? { label: option, value: option } : option,
);
---

<div class={styles.root} data-multi-select data-placeholder={placeholder}>
  <p id={`${id}-label`} class={styles.fieldLabel}>{label}</p>
  <button
    class={styles.trigger}
    type="button"
    popovertarget={`${id}-options`}
    aria-labelledby={`${id}-label ${id}-value`}
    aria-describedby={`${id}-hint`}
    data-select-trigger
  >
    <span id={`${id}-value`} data-selection-summary>{placeholder}</span>
    <Icon name="chevron-down" size={16} class={styles.chevron} />
  </button>
  <p id={`${id}-hint`} class={styles.hint}>{description}</p>

  <div
    id={`${id}-options`}
    class={styles.popover}
    popover
    role="group"
    aria-labelledby={`${id}-label`}
  >
    {filter && (
      <div class={styles.optionSearch}>
        <label for={`${id}-search`}>Search {label.toLowerCase()}</label>
        <input
          id={`${id}-search`}
          type="search"
          autocomplete="off"
          aria-describedby={`${id}-instructions`}
          data-option-search
        />
      </div>
    )}
    <p id={`${id}-instructions`} class="sr-only">
      Use the Up and Down Arrow keys to move between options. Press Space to toggle an option.
      {filter && "Start typing from an option to return to search."}
      Press Tab to leave the list.
    </p>
    <div class={styles.optionScroller}>
      <fieldset class={styles.optionList} aria-describedby={`${id}-instructions`}>
        <legend class="sr-only">{label}</legend>
        {normalizedOptions.map((option) => (
          <label class={styles.option} data-option-label={option.label}>
            <input type="checkbox" name={name} value={option.value} />
            <span>{option.label}</span>
          </label>
        ))}
      </fieldset>
    </div>
    {filter && (
      <p class={styles.hint} data-no-options aria-live="polite" hidden>
        No matching options.
      </p>
    )}
    <div class={styles.optionActions}>
      <button type="button" data-clear-options>Clear {label.toLowerCase()}</button>
      <button type="button" popovertarget={`${id}-options`} popovertargetaction="hide">Done</button>
    </div>
  </div>
</div>

<script>
  import { initMultiSelects } from "./MultiSelect";

  initMultiSelects();
  document.addEventListener("astro:page-load", initMultiSelects);
</script>
