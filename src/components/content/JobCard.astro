---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { formatMonthYear, toISODate } from "../../lib/dates";
import Icon from "../ui/Icon.astro";
import TechTagList from "../ui/TechTagList.astro";

interface Props {
  company: string;
  title: string;
  dateStart: Date;
  dateEnd?: Date;
  current: boolean;
  url?: string;
  summary: string;
  highlights: readonly string[];
  tech: readonly string[];
  logo?: ImageMetadata;
  logoAlt?: string;
}

const {
  company,
  title,
  dateStart,
  dateEnd,
  current,
  url,
  summary,
  highlights,
  tech,
  logo,
  logoAlt,
} = Astro.props;
const showEnd = !current && dateEnd !== undefined;
---

<article class="job">
  <!--
    DOM order matches visual order, so SC 1.3.2 is satisfied by construction
    rather than by a grid-area shuffle.
  -->
  <div class="job-aside">
    {
      logo && (
        /* Decorative by default: the company name is in the heading below, so an
           alt here would be a duplicate announcement. See jobs.logoAlt. */
        <Image
          src={logo}
          alt={logoAlt ?? ""}
          width={240}
          height={240}
          class="job-logo"
          loading="lazy"
        />
      )
    }

    <p class="job-period meta">
      <span class="sr-only">From </span>
      <time datetime={toISODate(dateStart)}>{formatMonthYear(dateStart)}</time>
      <span aria-hidden="true"> — </span><span class="sr-only"> to </span>
      {
        showEnd ? (
          <time datetime={toISODate(dateEnd!)}>{formatMonthYear(dateEnd!)}</time>
        ) : (
          /* Plain text: there is no valid datetime for "Present", and an invalid
             datetime is worse than none. */
          <span>Present</span>
        )
      }
    </p>
  </div>

  <div class="job-body">
    <h3 class="job-title">
      {
        url ? (
          <a class="job-link" href={url} rel="noopener noreferrer" target="_blank">
            <span>
              {title} · {company}
            </span>
            <span class="sr-only"> (opens in a new tab)</span>
            <Icon name="arrow-ne" size={16} />
          </a>
        ) : (
          <span>
            {title} · {company}
          </span>
        )
      }
    </h3>
    <p class="job-summary">{summary}</p>
    {
      highlights.length > 0 && (
        <ul class="job-highlights" role="list">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <TechTagList items={tech} label={`Technologies used at ${company}`} />
  </div>
</article>

<style>
  .job {
    position: relative;
    border-radius: var(--radius-lg);
  }

  .job + .job {
    margin-block-start: var(--spacing-10);
  }

  /* The hover card sits behind, inset negatively, so the highlight overflows the
     content box the way the inspiration does. */
  .job::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: calc(var(--spacing-4) * -1);
    border: 1px solid var(--border);
    border-radius: inherit;
    background-color: var(--surface-1);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  /*
   * :focus-within is NOT optional. A hover-only highlight means a keyboard user
   * tabbing the experience list gets no card affordance at all -- the single
   * most common bug in copies of this layout.
   */
  .job:hover::before,
  .job:focus-within::before {
    opacity: 1;
  }

  /* Sits above the date and spans the date column, so the tile edge lines up
     with the date text below it at every width. contain, never cover: a brand
     mark cropped to fill its box is a mangled logo. */
  .job-logo {
    inline-size: var(--job-date-col);
    block-size: auto;
    aspect-ratio: 1;
    padding: var(--spacing-2);
    object-fit: contain;
    margin-block-end: var(--spacing-3);
  }

  /* Typography comes from .meta; this is the optical nudge that lines the
     date up with the first line of the title beside it. */
  .job-period {
    padding-block-start: 0.2em;
  }

  /* With a logo present the date no longer sits on the title's first line, so
     the optical nudge that aligned them would just add a stray gap. */
  .job-aside:has(.job-logo) .job-period {
    padding-block-start: 0;
  }

  .job-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .job-summary,
  .job-highlights {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  .job-highlights {
    padding-inline-start: var(--spacing-5);
    list-style: disc;
  }

  .job-highlights li::marker {
    color: var(--accent);
  }

  .job-highlights li + li {
    margin-block-start: var(--spacing-2);
  }

  .job-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-1);
    color: var(--fg);
    text-decoration: none;
  }

  /*
   * Stretched link, not a card-wide <a>: the accessible name stays the job title
   * instead of becoming the card's entire text content.
   * Knowing trade-off: text inside the card cannot be drag-selected.
   */
  .job-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* Any nested link must be raised above the stretched overlay. Enforced
     globally here rather than remembered per instance. */
  .job :where(a, button):not(.job-link) {
    position: relative;
    z-index: 1;
  }

  .job:hover .job-link,
  .job:focus-within .job-link {
    color: var(--accent);
  }

  .job-link :global(.icon) {
    transition: translate var(--dur-fast) var(--ease);
  }

  .job:hover .job-link :global(.icon) {
    translate: 0.15em -0.15em;
  }

  @media (min-width: 48rem) {
    .job {
      display: grid;
      /* .job-aside is column one -- logo stacked over date -- so a role with no
         logo lays out exactly as it did before. */
      grid-template-columns: var(--job-date-col) 1fr;
      column-gap: var(--spacing-6);
    }
  }
</style>
