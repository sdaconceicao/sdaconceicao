---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { type JobRole, jobTenure } from "../../lib/jobs";
import Icon from "../ui/Icon.astro";
import TechTagList from "../ui/TechTagList.astro";
import DateRange from "./DateRange.astro";

interface Props {
  company: string;
  titles: readonly JobRole[];
  url?: string;
  summary: string;
  highlights: readonly string[];
  tech: readonly string[];
  logo?: ImageMetadata;
  logoAlt?: string;
}

const { company, titles, url, summary, highlights, tech, logo, logoAlt } = Astro.props;
const tenure = jobTenure(titles);
const startYear = tenure.dateStart.getUTCFullYear();
const endYear = tenure.dateEnd?.getUTCFullYear();
const tenureLabel = tenure.current
  ? `${startYear} to present`
  : endYear === startYear
    ? String(startYear)
    : `${startYear} to ${endYear}`;
---

<article class="job" data-current={tenure.current}>
  <div class="job-period">
    <span class="timeline-dot" aria-hidden="true"></span>
    <span class="meta">
      <span class="sr-only">{tenureLabel}</span>
      <span aria-hidden="true">
        {startYear}{endYear !== startYear && <> — {tenure.current ? "Present" : endYear}</>}
      </span>
    </span>
  </div>

  <div class="job-body">
    <div class="job-heading">
      {
        logo && (
          <Image
            src={logo}
            alt={logoAlt ?? ""}
            width={96}
            height={96}
            class="job-logo"
            loading="lazy"
          />
        )
      }
      <div>
        <h3 class="job-title">
          {
            url ? (
              <a class="job-link" href={url} rel="noopener noreferrer" target="_blank">
                <span>{company}</span>
                <span class="sr-only"> (opens in a new tab)</span>
                <Icon name="arrow-ne" size={16} />
              </a>
            ) : (
              <span>{company}</span>
            )
          }
        </h3>

        <ol class="job-roles" role="list">
          {
            titles.map((role) => (
              <li>
                <span class="job-role-title">{role.title}</span>
                <span class="job-role-period meta">
                  <DateRange
                    dateStart={role.dateStart}
                    dateEnd={role.dateEnd}
                    current={role.current}
                  />
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <p class="job-summary">{summary}</p>
    {
      highlights.length > 0 && (
        <ul class="job-highlights" role="list">
          {highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }
    <TechTagList items={tech} label={`Technologies used at ${company}`} />
  </div>
</article>

<style>
  .job {
    position: relative;
    isolation: isolate;
    display: block;
    border-block-start: 1px solid var(--border);
  }

  .job:last-of-type {
    border-block-end: 1px solid var(--border);
  }

  .job:first-child {
    border-block-start: 0;
  }

  .job::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0 calc(var(--spacing-3) * -1);
    background-color: var(--surface-1);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .job:hover::before,
  .job:focus-within::before {
    opacity: 1;
  }

  .job-period {
    display: none;
  }

  .job-period .meta {
    display: block;
    color: var(--fg-muted);
    line-height: var(--leading-snug);
  }

  .job-period::after {
    content: "";
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    border-inline-end: 1px solid var(--border-strong);
  }

  .job:first-child .job-period::after {
    inset-block-start: var(--spacing-8);
  }

  .job:last-child .job-period::after {
    inset-block-end: calc(100% - var(--spacing-8));
  }

  .timeline-dot {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--spacing-6);
    inset-inline-end: calc(var(--spacing-2) * -1);
    inline-size: var(--spacing-4);
    block-size: var(--spacing-4);
    border: 1px solid var(--fg-muted);
    border-radius: var(--radius-pill);
    background-color: var(--bg);
  }

  .job[data-current="true"] .timeline-dot {
    border-color: var(--accent);
    background-color: var(--accent);
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  .job-body {
    min-inline-size: 0;
    padding-block: var(--spacing-6);
  }

  .job-heading {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-4);
  }

  .job-logo {
    flex: 0 0 auto;
    inline-size: var(--spacing-12);
    aspect-ratio: 1;
    object-fit: contain;
  }

  .job-title {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .job-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    color: var(--fg);
    text-decoration: none;
  }

  .job-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .job:hover .job-link,
  .job:focus-within .job-link {
    color: var(--accent);
  }

  .job-roles {
    margin-block-start: var(--spacing-1);
  }

  .job-roles li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--spacing-3);
  }

  .job-roles li + li {
    margin-block-start: var(--spacing-1);
  }

  .job-role-title {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .job-summary,
  .job-highlights {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  .job-highlights {
    display: grid;
    gap: var(--spacing-2);
  }

  .job-highlights li {
    position: relative;
    padding-inline-start: var(--spacing-4);
  }

  .job-highlights li::before {
    content: "›";
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
    font-family: var(--font-mono);
  }

  @media (min-width: 64rem) and (min-height: 48rem) {
    .job {
      display: grid;
      grid-template-columns: var(--timeline-col) minmax(0, 1fr);
    }

    .job-period {
      display: block;
      position: relative;
      padding-block: var(--spacing-6);
      padding-inline-end: var(--spacing-4);
    }

    .job-body {
      padding-inline-start: var(--spacing-6);
    }
  }
</style>
