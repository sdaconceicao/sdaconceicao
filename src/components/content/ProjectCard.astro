---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../ui/Icon.astro";
import TechTagList from "../ui/TechTagList.astro";

interface Props {
  title: string;
  description: string;
  href?: string;
  repo?: string;
  tech: readonly string[];
  image?: ImageMetadata;
  imageAlt?: string;
  status: "live" | "archived" | "wip";
  body?: string;
}

const { title, description, href, repo, tech, image, imageAlt, status } = Astro.props;
const primary = href ?? repo;
const external = primary !== undefined;
/* A status other than "live" is conveyed as TEXT, not a colour. */
const statusLabel = status === "wip" ? "In progress" : status === "archived" ? "Archived" : null;
---

<article class="project">
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? ""}
        width={200}
        height={120}
        class="project-image"
        loading="lazy"
      />
    )
  }

  <div class="project-body">
    <h3 class="project-title">
      {
        primary ? (
          <a class="project-link" href={primary} rel="noopener noreferrer" target="_blank">
            <span>{title}</span>
            {external && <span class="sr-only"> (opens in a new tab)</span>}
            <Icon name="arrow-ne" size={16} />
          </a>
        ) : (
          <span>{title}</span>
        )
      }
      {statusLabel && <span class="project-status">{statusLabel}</span>}
    </h3>

    <p class="project-description">{description}</p>

    {
      href && repo && (
        <p class="project-repo">
          <a href={repo} rel="noopener noreferrer" target="_blank">
            <Icon name="github" size={16} />
            <span>Source</span>
            <span class="sr-only"> for {title} (opens in a new tab)</span>
          </a>
        </p>
      )
    }

    <TechTagList items={tech} label={`Technologies used in ${title}`} />
  </div>
</article>

<style>
  .project {
    position: relative;
    border-radius: var(--radius-lg);
  }

  .project + .project {
    margin-block-start: var(--spacing-10);
  }

  .project::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: calc(var(--spacing-4) * -1);
    border: 1px solid var(--border);
    border-radius: inherit;
    background-color: var(--surface-1);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .project:hover::before,
  .project:focus-within::before {
    opacity: 1;
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .project-status {
    padding: 0 var(--spacing-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    color: var(--fg-dim);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .project-description {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  .project-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-1);
    color: var(--fg);
    text-decoration: none;
  }

  .project-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project :where(a, button):not(.project-link) {
    position: relative;
    z-index: 1;
  }

  .project:hover .project-link,
  .project:focus-within .project-link {
    color: var(--accent);
  }

  .project-link :global(.icon) {
    transition: translate var(--dur-fast) var(--ease);
  }

  .project:hover .project-link :global(.icon) {
    translate: 0.15em -0.15em;
  }

  .project-repo {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  .project-repo a {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    color: var(--fg-muted);
    text-decoration: none;
  }

  .project-repo a:hover {
    color: var(--accent);
  }

  .project-image {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    object-fit: cover;
    margin-block-end: var(--spacing-4);
  }

  @media (min-width: 48rem) {
    .project {
      display: grid;
      grid-template-columns: var(--job-date-col) 1fr;
      column-gap: var(--spacing-6);
    }

    .project-image {
      margin-block-end: 0;
      inline-size: 100%;
      block-size: auto;
    }

    .project:not(:has(.project-image)) .project-body {
      grid-column: 1 / -1;
    }
  }
</style>
