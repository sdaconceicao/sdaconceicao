---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "../ui/Icon.astro";
import TechTagList from "../ui/TechTagList.astro";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  title: string;
  description: string;
  slug: string;
  href?: string;
  repo?: string;
  tech: readonly string[];
  image?: ImageMetadata;
  imageAlt?: string;
  status: "live" | "archived" | "wip";
  body?: string;
}

const { title, description, slug, href, repo, tech, image, imageAlt, status } = Astro.props;
const detailHref = `/projects/${slug}`;
/* A status other than "live" is conveyed as TEXT, not a colour. */
const statusLabel = status === "wip" ? "In progress" : status === "archived" ? "Archived" : null;
---

<article class="project">
  {
    image && (
      <Image
        src={image}
        alt={imageAlt ?? ""}
        width={200}
        height={120}
        class="project-image"
        loading="lazy"
      />
    )
  }

  <div class="project-body">
    <h3 class="project-title">
      <a class="project-link" href={detailHref}>
        <span>{title}</span>
        <Icon name="arrow-e" size={16} />
      </a>
      {statusLabel && <span class="project-status pill meta">{statusLabel}</span>}
    </h3>

    <p class="project-description">{description}</p>

    <ProjectLinks title={title} href={href} repo={repo} />

    <TechTagList items={tech} label={`Technologies used in ${title}`} />
  </div>
</article>

<style>
  .project {
    position: relative;
    border-radius: var(--radius-lg);
  }

  .project + .project {
    margin-block-start: var(--spacing-10);
  }

  .project::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: calc(var(--spacing-4) * -1);
    border: 1px solid var(--border);
    border-radius: inherit;
    background-color: var(--surface-1);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .project:hover::before,
  .project:focus-within::before {
    opacity: 1;
  }

  .project-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-3);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .project-status {
    padding: 0 var(--spacing-2);
    border: 1px solid var(--border-strong);
  }

  .project-description {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  .project-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-1);
    color: var(--fg);
    text-decoration: none;
  }

  .project-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .project :global(a:not(.project-link)),
  .project :global(button) {
    position: relative;
    z-index: 1;
  }

  .project:hover .project-link,
  .project:focus-within .project-link {
    color: var(--accent);
  }

  .project-link :global(.icon) {
    transition: translate var(--dur-fast) var(--ease);
  }

  .project:hover .project-link :global(.icon) {
    translate: 0.15em -0.15em;
  }

  .project-image {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    object-fit: cover;
    margin-block-end: var(--spacing-4);
  }

  @media (min-width: 48rem) {
    .project {
      display: grid;
      grid-template-columns: var(--job-date-col) 1fr;
      column-gap: var(--spacing-6);
    }

    .project-image {
      margin-block-end: 0;
      inline-size: 100%;
      block-size: auto;
    }

    .project:not(:has(.project-image)) .project-body {
      grid-column: 1 / -1;
    }
  }
</style>
