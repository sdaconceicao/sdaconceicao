---
import Icon from "../ui/Icon.astro";
import TechTagList from "../ui/TechTagList.astro";
import FormattedDate from "./FormattedDate.astro";

interface Props {
  title: string;
  href: string;
  pubDate: Date;
  description: string;
  tags: readonly string[];
  readingTime?: number;
}
const { title, href, pubDate, description, tags, readingTime } = Astro.props;
---

<article class="post-card">
  <p class="post-meta meta">
    <FormattedDate date={pubDate} format="month" />
    {readingTime !== undefined && readingTime > 0 && (
      <>
        <span aria-hidden="true"> · </span>
        <span>{readingTime} min read</span>
      </>
    )}
  </p>

  <div>
    <h3 class="post-title">
      <a class="post-link" href={href}>
        <span>{title}</span>
        <Icon name="arrow-e" size={16} />
      </a>
    </h3>
    <p class="post-description">{description}</p>
    <TechTagList items={tags} label={`Tags for ${title}`} />
  </div>
</article>

<style>
  .post-card {
    position: relative;
    border-radius: var(--radius-lg);
  }

  .post-card + .post-card {
    margin-block-start: var(--spacing-10);
  }

  .post-card::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: calc(var(--spacing-4) * -1);
    border: 1px solid var(--border);
    border-radius: inherit;
    background-color: var(--surface-1);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .post-card:hover::before,
  .post-card:focus-within::before {
    opacity: 1;
  }

  .post-meta {
    padding-block-start: 0.2em;
  }

  .post-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .post-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--spacing-1);
    color: var(--fg);
    text-decoration: none;
  }

  .post-link::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .post-card :where(a, button):not(.post-link) {
    position: relative;
    z-index: 1;
  }

  .post-card:hover .post-link,
  .post-card:focus-within .post-link {
    color: var(--accent);
  }

  .post-link :global(.icon) {
    transition: translate var(--dur-fast) var(--ease);
  }

  .post-card:hover .post-link :global(.icon) {
    translate: 0.2em 0;
  }

  .post-description {
    margin-block-start: var(--spacing-3);
    font-size: var(--text-sm);
  }

  @media (min-width: 48rem) {
    .post-card {
      display: grid;
      grid-template-columns: var(--job-date-col) 1fr;
      column-gap: var(--spacing-6);
    }
  }
</style>
