---
import Spotlight from "../components/layout/Spotlight.astro";
import BaseHead from "../components/seo/BaseHead.astro";
import SkipLink from "../components/ui/SkipLink.astro";
import { SITE } from "../site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}
const props = Astro.props;
---

<!doctype html>
<html lang={SITE.locale} dir="ltr">
  <head>
    <BaseHead {...props} />
  </head>
  <body>
    <!-- Must be the first focusable element in the DOM. -->
    <SkipLink />
    <Spotlight />
    <slot />
  </body>
</html>
