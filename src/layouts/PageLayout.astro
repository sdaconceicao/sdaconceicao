---
import FloatingHeader from "../components/layout/FloatingHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { PAGE_LINKS } from "../site";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  backHref?: string;
  backLabel?: string;
  fullWidthAtWide?: boolean;
}
const { backHref = "/", backLabel = "Back home", fullWidthAtWide = false, ...head } = Astro.props;
const isDetailPage = Astro.url.pathname.split("/").filter(Boolean).length > 1;
---

<BaseLayout {...head}>
  <FloatingHeader variant="page" items={PAGE_LINKS} label="Primary" homeHref="/" />
  <div class="page-shell" data-width={fullWidthAtWide ? "full" : "bounded"}>
    <main id="main" class="page-main" data-detail={isDetailPage}>
      {
        isDetailPage && (
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol class="breadcrumb-list" role="list">
              <li><a href={backHref}>{backLabel}</a></li>
              <li aria-current="page">{Astro.props.title}</li>
            </ol>
          </nav>
        )
      }
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page-shell {
    max-inline-size: var(--layout-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block-end: calc(var(--spacing-16) + env(safe-area-inset-bottom));
  }

  .page-main {
    padding-block: var(--spacing-12);
  }

  .breadcrumb {
    margin-block-end: var(--spacing-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-2);
  }

  .breadcrumb li + li::before {
    margin-inline-end: var(--spacing-2);
    color: var(--fg-dim);
    content: "/";
  }

  .breadcrumb a {
    color: var(--accent);
    text-underline-offset: var(--spacing-1);
  }

  .page-main[data-detail="true"] {
    padding-block-start: var(--spacing-6);
  }

  @media (min-width: 64rem) and (min-height: 48rem) {
    .page-shell {
      padding-block-end: 0;
    }

    .page-main,
    .page-main[data-detail="true"] {
      padding-block: var(--spacing-6) var(--spacing-16);
    }
  }

  @media (min-width: 90rem) {
    .page-shell[data-width="full"] {
      max-inline-size: none;
    }
  }
</style>
