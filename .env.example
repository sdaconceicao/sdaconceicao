# GitHub OAuth App credentials for the Decap CMS backend.
# Set these in Vercel for the PRODUCTION environment only -- preview deploys get
# random hostnames that can never match the OAuth App's single callback URL, so
# leaving OAuth unconfigured there is the correct fail-closed state.
#
# Local authoring needs NEITHER of these: run `pnpm cms:dev` and Decap's
# local_backend writes straight to disk.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
